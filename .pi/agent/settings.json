{
  "lastChangelogVersion": "0.84.1",
  "theme": "dark",
  "compaction": {
    "enabled": true
  },
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:@dietrichgebert/ponytail",
    "npm:@narumitw/pi-usage"
  ],
  "enableInstallTelemetry": false,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "max",
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "max",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/gpt-5.6-sol",
        "openai-codex/gpt-5.6-luna",
        "opencode-go/deepseek-v4-flash"
      ]
    },
    "agentOverrides": {
      "planner": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "fallbackModels": [
          "opencode-go/deepseek-v4-flash:high"
        ]
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "fallbackModels": [
          "opencode-go/deepseek-v4-flash:high"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "fallbackModels": [
          "opencode-go/deepseek-v4-flash:high"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "fallbackModels": [
          "opencode-go/deepseek-v4-flash:high"
        ]
      },
      "advisor": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "fallbackModels": [
          "opencode-go/deepseek-v4-flash:high"
        ]
      },
      "scout": {
        "model": "opencode-go/deepseek-v4-flash",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna:max"
        ]
      },
      "researcher": {
        "model": "opencode-go/deepseek-v4-flash",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna:max"
        ]
      },
      "worker": {
        "model": "opencode-go/deepseek-v4-flash",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna:max"
        ]
      },
      "delegate": {
        "model": "opencode-go/deepseek-v4-flash",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna:max"
        ]
      }
    }
  }
}